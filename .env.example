# Servidor
PORT=3000
PUBLIC_BASE_URL=https://seu-dominio-publico.example
WEBHOOK_VERIFY_TOKEN=troque-por-um-segredo-longo

# WhatsApp Cloud API (Meta Developers > WhatsApp > API Setup)
WHATSAPP_TOKEN=cole_o_token_de_acesso_aqui
WHATSAPP_PHONE_NUMBER_ID=cole_o_phone_number_id
WHATSAPP_API_VERSION=v23.0

# IA (OpenAI API)
OPENAI_API_KEY=cole_sua_chave_aqui
OPENAI_MODEL=gpt-5.5

# Identidade: random escolhe uma personalidade a cada nova conversa
BOT_PERSONALITY_MODE=random
CITY_NAME=Sua cidade
